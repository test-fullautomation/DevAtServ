#!/bin/bash

set -e

source /opt/devatserv/share/util/format.sh

CURRENT_USER=${SUDO_USER}
if [ -z ${CURRENT_USER} ]; then
   CURRENT_USER=$(whoami)
fi
# When executing as root user $HOME can be /root
# Otherwises, /home/<user> should be used
if [ ${CURRENT_USER} != 'root' ]; then
   HOME=/home/${CURRENT_USER}
fi

# Introduce group `robot-aio` which allow access for group of multiple users
sGROUP=robot-aio

# Configure Unitiy Launchers folder
APPS_PATH=${HOME}/.local/share/applications
if [ -e "${APPS_PATH}" ]; then
   # Check whether it is file or directory
   # remove it in case it is fine then create appropriate directory 
   if [ -f "${APPS_PATH}" ]; then
      rm "${APPS_PATH}"
      mkdir "${APPS_PATH}"
   fi
else
   # Create applications launcher folder if not existing
   mkdir "${APPS_PATH}"
fi

cp /opt/devatserv/bin/devatserv /usr/local/bin/devatserv
chmod +x /usr/local/bin/devatserv

cp /opt/devatserv/share/applications/devatserv.desktop ${APPS_PATH}/devatserv.desktop


# For scrip excution
# Adding execute permissions for the owner, group, and others
chown -R "${CURRENT_USER}:${sGROUP}" ${APPS_PATH}/devatserv.desktop
chmod +x ${APPS_PATH}/devatserv.desktop
chmod +x /opt/devatserv/bin/devatserv
chmod +x /opt/devatserv/bin/start-devatserv.sh
chmod +x /opt/devatserv/bin/startup-devatserv.sh
chmod +x /opt/devatserv/bin/remove-devatserv.sh
chmod +x /opt/devatserv/share/util/install_docker_lx.sh

# For share configuration yaml
# (U)ser / owner can read, can write and can't execute. 
# (G)roup can read, can write and can't execute.
# (O)thers can read, can't write and can't execute.
# chown -R "${CURRENT_USER}:${sGROUP}" /opt/devatserv/share/start-services/docker-compose.cleware.yml
# chown -R "${CURRENT_USER}:${sGROUP}" /opt/devatserv/share/start-services/docker-compose.debugboard.yml
# chmod 664 /opt/devatserv/share/start-services/docker-compose.cleware.yml
# chmod 664 /opt/devatserv/share/start-services/docker-compose.debugboard.yml

echo -e "${MSG_DONE} Device Automation Services App has been successfully created/updated."
